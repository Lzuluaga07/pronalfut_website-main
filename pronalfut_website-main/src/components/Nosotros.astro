---
import traducciones from '../data/idiomas.json';

const esIngles = Astro.url.pathname.startsWith('/en');
const idioma = esIngles ? 'en' : 'es';

const t = traducciones[idioma].nosotros;
---

<section class="py-20 bg-white" id="nosotros">
  <div class="container mx-auto px-6">
    
    <div class="max-w-4xl mx-auto text-center mb-16">
      <h2 class="text-3xl font-bold text-green-700 md:text-3xl mb-4 tracking-wide">
        {t.titulo}
      </h2>
      <p class="text-xl text-gray-700 leading-relaxed">
        {t.descripcion}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-12 mb-20 mt-12">
      <!-- Bloque de Misión -->
      <div class="p-10 rounded-2xl bg-slate-50 border-t-8 border-purple-800 shadow-sm">
        <h3 class="text-2xl font-bold text-purple-900 mb-4 flex items-center gap-2">
          🎯 {t.misionTitulo}
        </h3>
        <p class="text-gray-700 text-lg leading-relaxed">
          {t.misionTexto}
        </p>
      </div>

      <!-- Bloque de Visión -->
      <div class="p-10 rounded-2xl bg-slate-50 border-t-8 border-purple-800 shadow-sm">
        <h3 class="text-2xl font-bold text-purple-900 mb-4 flex items-center gap-2">
          🚀 {t.visionTitulo}
        </h3>
        <p class="text-gray-700 text-lg leading-relaxed">
          {t.visionTexto}
        </p>
      </div>
    </div>

  </div>
</section>

