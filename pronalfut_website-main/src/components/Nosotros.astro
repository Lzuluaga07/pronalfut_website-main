---
import traducciones from '../data/idiomas.json';
const esIngles = Astro.url.pathname.startsWith('/en/');
const idioma = esIngles ? 'en' : 'es';
const t = traducciones[idioma].nosotros;
---

<section class="py-20 bg-gray-50" id="nosotros">
  <div class="container mx-auto px-6">
    
    <div class="max-w-4xl mx-auto mb-16 p-10 bg-white rounded-3xl shadow-lg border border-gray-100 text-center">
      <h2 class="text-3xl font-bold text-purple-900 mb-6 tracking-wide">
        {t.titulo}
      </h2>
      <p class="text-xl text-gray-700 leading-relaxed">
        {t.descripcion}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      
      <div class="p-10 rounded-3xl bg-white shadow-lg border border-gray-100">
        <h3 class="text-2xl font-bold text-purple-900 mb-4 flex items-center gap-2">
          🎯 {t.misionTitulo}
        </h3>
        <p class="text-gray-700 text-lg leading-relaxed">
          {t.misionTexto}
        </p>
      </div>

      <div class="p-10 rounded-3xl bg-white shadow-lg border border-gray-100">
        <h3 class="text-2xl font-bold text-purple-900 mb-4 flex items-center gap-2">
          🚀 {t.visionTitulo}
        </h3>
        <p class="text-gray-700 text-lg leading-relaxed">
          {t.visionTexto}
        </p>
      </div>
    </div>
  </div>
</section>




