---
import traducciones from '../data/idiomas.json';

const esIngles = Astro.url.pathname.startsWith('/en');
const idioma = esIngles ? 'en' : 'es';

const t = traducciones[idioma].contacto;
---

<section id="contacto" class="py-16 bg-gray-50">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl md:text-5xl font-bold text-center text-green-800 mb-8">
      {t.titulo}
    </h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      
      <!-- Información de Contacto (US7.2 y US7.3) -->
      <div class="space-y-6">
        <h3 class="text-xl font-semibold mb-4">{t.subtitulo}</h3>
        
 <div class="flex flex-col gap-6 py-8 max-w-2xl">
    
    <!-- Dirección -->
    <div class="flex items-center gap-4">
        <span class="material-symbols-outlined text-emerald-600 text-3xl">location_on</span>
        <p class="text-lg text-gray-700">Cra. 64A #4b-41, Bogotá D.C.</p>
    </div>

    <!-- Teléfono -->
    <div class="flex items-center gap-4">
        <span class="material-symbols-outlined text-emerald-600 text-3xl">call</span>
        <p class="text-lg text-gray-700">+57 (601) 420-27-30 (PBX)</p>
    </div>

    <!-- Correo -->
    <div class="flex items-center gap-4">
        <span class="material-symbols-outlined text-emerald-600 text-3xl">email</span>
        <p class="text-lg text-gray-700">sales@pronalfrut.com</p>
    </div>

   



            
<form class="bg-white p-6 rounded-lg shadow-md flex flex-col gap-4 w-full max-w-2xl mx-auto">
    <input 
        type="text" 
        placeholder="Nombre" 
        class="w-full border p-3 rounded focus:outline-purple-500" 
        required 
    />
    <input 
        type="email" 
        placeholder="Email" 
        class="w-full border p-3 rounded focus:outline-purple-500" 
        required 
    />
    <textarea 
        placeholder="Mensaje" 
        rows="4" 
        class="w-full border p-3 rounded focus:outline-purple-500" 
        required
    ></textarea>
    <button 
        type="submit" 
        class="w-full bg-purple-700 text-white font-bold py-3 rounded hover:bg-purple-800 transition"
    >
        Enviar Mensaje
    </button>
</form>





