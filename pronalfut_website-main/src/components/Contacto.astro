---

<section id="contacto" class="py-16 bg-gray-50">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-center mb-12 text-purple-900">Contacto</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      
      <!-- Información de Contacto (US7.2 y US7.3) -->
      <div class="space-y-6">
        <h3 class="text-xl font-semibold mb-4">¡Hablemos!</h3>
        <div class="flex items-center gap-4">
          <span class="material-symbols-outlined text-purple-700">location_on</span>
          <p>Cra. 64a #4b-41, Bogotá D.C.</p>
        </div>
        <div class="flex items-center gap-4">
          <span class="material-symbols-outlined text-purple-700">call</span>
          <p>+57 (601) 420-27-30</p>
        </div>
        <div class="flex items-center gap-4">
          <span class="material-symbols-outlined text-purple-700">mail</span>
          <p>produccion@pronalfrut.com</p>
        </div>
      </div>

      <!-- Formulario Básico (US7.1) -->
      <form class="flex flex-col gap-4 bg-white p-6 rounded-lg shadow-md">
        <input 
          type="text" 
          placeholder="Nombre" 
          class="border p-3 rounded focus:outline-purple-500" 
          required 
        />
        <input 
          type="email" 
          placeholder="Email" 
          class="border p-3 rounded focus:outline-purple-500" 
          required 
        />
        <textarea 
          placeholder="Mensaje" 
          rows="4" 
          class="border p-3 rounded focus:outline-purple-500" 
          required
        ></textarea>
        <button 
          type="submit" 
          class="bg-purple-700 text-white font-bold py-3 rounded hover:bg-purple-800 transition"
        >
          Enviar Mensaje
        </button>
      </form>

    </div>
  </div>
</section>


