---
interface Props {
  logoText?: string;
  whatsappLink?: string;
}

const {
  logoText = "Pronalfrut",
  whatsappLink = "https://wa.me/5733005519049"
} = Astro.props as Props;
---

<header class="sticky top-0 z-50 w-full bg-white shadow-md">
  <div class="w-full px-4 md:px-20">
    <div class="flex w-full justify-between items-center h-20 md:h-32">
      
      <div class="flex-shrink-0">
        <a href="#inicio" class="flex items-center">
          <img 
            src="/test-logo.png" 
            alt="Logo oficial Pronalfrut" 
            class="h-10 md:h-24 w-auto object-contain"
          />
        </a>
      </div>
    <button id="menu-button" class="block md:hidden text-gray-700 focus:outline-none">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>

      <nav id="menu-items" class="hidden md:flex flex-col md:flex-row absolute md:static top-20 left-0 w-full md:w-auto bg-white md:bg-transparent p-4 md:p-0 shadow-md md:shadow-none space-y-4 md:space-y-0 md:space-x-8 z-50">
        <a href="/" class="text-gray-700 hover:text-green-600 font-medium transition-colors">Inicio</a>
        <a href="#nosotros" class="text-gray-700 hover:text-green-600 font-medium transition-colors">Nosotros</a>
        <a href="#productos" class="text-gray-700 hover:text-green-600 font-medium transition-colors">Productos</a>
        <a href="/blog" class="text-gray-600 hover:text-green-600 font-medium transition-colors">Blog</a>
        <a href="#contacto" class="text-gray-700 hover:text-green-600 font-medium transition-colors">Contacto</a>
       <div class="flex items-center gap-1 text-gray-700 font-medium ml-4 border-l pl-4 border-gray-300">
        <span class="material-symbols-outlined text-orange-600 text-[20px]">
          location_on
        </span>
        <span class="text-sm">Bogotá, Colombia</span>
      </div> 
     <div class="flex items-center gap-2 ml-4 border-l pl-4 border-gray-300 text-sm font-medium">
        <button id="btn-es" class="text-green-800 font-bold cursor-pointer transition-colors hover:text-green-600">ES</button>
        <span class="text-gray-400">|</span>
        <button id="btn-en" class="text-gray-500 cursor-pointer transition-colors hover:text-green-600">EN</button>
      </div> 
      
    </nav>

  <a 
    href={whatsappLink} 
    target="_blank" 
    class="fixed bottom-6 right-6 z-50 bg-green-600 text-white p-4 rounded-full shadow-2xl hover:bg-green-700 transition-all flex items-center justify-center">

  <span class="font-bold">Chat</span>
</a>

    </div>
  </div>
</header>

<style is:global>
  html { scroll-behavior: smooth; }
</style>

<style>
  a { transition: transform 0.2s; }
  a:hover { transform: scale(1.05); }
</style>

<script>
  // 1. SELECTORES DE IDIOMA
  const btnEs = document.getElementById('btn-es');
  const btnEn = document.getElementById('btn-en');

  function setLanguage(lang: string) {
    const currentPath = window.location.pathname;
    
    if (lang === 'en') {
      btnEn?.classList.add('text-green-800', 'font-bold');
      btnEn?.classList.remove('text-gray-500');
      btnEs?.classList.add('text-gray-500');
      btnEs?.classList.remove('text-green-800', 'font-bold');
      
      if (!currentPath.startsWith('/en')) {
        window.location.href = '/en/';
      }
    } else {
      btnEs?.classList.add('text-green-800', 'font-bold');
      btnEs?.classList.remove('text-gray-500');
      btnEn?.classList.add('text-gray-500');
      btnEn?.classList.remove('text-green-800', 'font-bold');
      
      if (currentPath.startsWith('/en')) {
        window.location.href = currentPath.replace('/en', '') || '/';
      }
   }
  } // <- Esta es la llave que faltaba para cerrar "setLanguage"

  // 2. ESCUCHAR LOS CLICS EN LOS BOTONES
  btnEs?.addEventListener('click', () => setLanguage('es'));
  btnEn?.addEventListener('click', () => setLanguage('en'));

  // 3. MARCAR EL BOTÓN ACTIVO AL CARGAR LA PÁGINA
  if (window.location.pathname.startsWith('/en')) {
    btnEn?.classList.add('text-green-800', 'font-bold');
    btnEn?.classList.remove('text-gray-500');
    btnEs?.classList.add('text-gray-500');
    btnEs?.classList.remove('text-green-800', 'font-bold');
  } else {
    btnEs?.classList.add('text-green-800', 'font-bold');
    btnEs?.classList.remove('text-gray-500');
    btnEn?.classList.add('text-gray-500');
    btnEn?.classList.remove('text-green-800', 'font-bold');
  }
  btnEs?.addEventListener('click', () => setLanguage('es'));
  btnEn?.addEventListener('click', () => setLanguage('en'));
  // 4. LÓGICA DEL MENÚ HAMBURGUESA (MÓVIL)
  const menuButton = document.getElementById('menu-button');
  const menuItems = document.getElementById('menu-items');
  const navLinks = document.querySelectorAll('#menu-items a');

  menuButton?.addEventListener('click', () => {
    menuItems?.classList.toggle('hidden');
    menuItems?.classList.toggle('flex');
  });

  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      menuItems?.classList.add('hidden');
      menuItems?.classList.remove('flex');
    });
  });
</script>