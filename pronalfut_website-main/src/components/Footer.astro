---
import traducciones from '../data/idiomas.json';

const currentYear = new Date().getFullYear();
const esIngles = Astro.url.pathname.startsWith('/en');
const idioma = esIngles ? 'en' : 'es';

const t = traducciones[idioma].footer;
---

<footer id="contacto" class="bg-[#4c1d95] text-white py-12 mt-10">
 class="container mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-10 max-w-7xl"

    
    <div class="space-y-4">
     <h3 class="text-2xl font-bold text-white tracking-tight">Alimentos Pronalfrut</h3> 
      <p class="text-sm text-purple-200 font-semibold">NIT: 900436915</p>
      <p class="text-purple-100 text-sm leading-relaxed">
        {t.descripcion}
      </p>
    </div>

    <div class="space-y-4">
      <h3 class="text-xl font-bold border-b-2 border-green-500 w-fit pb-1">{t.navTitulo}</h3>
      <ul class="space-y-2 text-purple-100 text-sm">
        <li><a href="/" class="hover:text-green-400 transition-colors">{t.navInicio}</a></li>
        <li><a href="#nosotros" class="hover:text-green-400 transition-colors">{t.navNosotros}</a></li>
        <li><a href="#productos" class="hover:text-green-400 transition-colors">{t.navProductos}</a></li>
        <li><a href="#testimonios" class="hover:text-green-400 transition-colors">{t.navClientes}</a></li>
        <li><a href="/blog" class="hover:text-green-400 transition-colors">{t.navBlog}</a></li>
      </ul>
    </div>


<div class="space-y-4 w-full md:col-span-3"> 
  <h3 class="text-xl font-bold border-b-2 border-green-500 w-fit pb-1">{t.contactoTitulo}</h3>
  <!-- ... resto de tu contenido ... -->
</div>
      <!-- Datos de Contacto -->
      <div class="space-y-2 text-purple-100 text-sm">
        <div class="flex items-start gap-3">
          <span class="material-symbols-outlined">location_on</span>
          <p>Cra. 64A # 4B-41, Bogotá, Colombia</p>
        </div>
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined">call</span>
          <p>601 420 2730</p>
        </div>
        <div class="flex items-center gap-3">
          
          <span class="material-symbols-outlined">mail</span>
          <p><a href="mailto:sales@pronalfrut.com" class="hover:text-white transition-colors">sales@pronalfrut.com</a></p>
        </div>
      </div>  

    </div> 
   
    </div> 

    <!-- NUEVO BLOQUE: MAPA Y REDES -->
    <div class="container mx-auto px-6 mt-10">
        <div class="w-full h-80 overflow-hidden rounded-lg shadow-md">
        
        </div>
        <div class="flex justify-center gap-6 mt-6">
            <a href="https://www.facebook.com/pronalfrut" target="_blank"><img src="/images/facebook.svg" alt="Facebook" class="w-10 h-10"></a>
            <a href="https://www.instagram.com/pronalfrut" target="_blank"><img src="/images/instagram.svg" alt="Instagram" class="w-10 h-10"></a>
        </div>
    </div> 

    
     
  <div class="w-full border-t border-purple-800 mt-10 pt-8">
    <p class="text-center text-purple-300 text-xs px-4">
      {currentYear} Alimentos Pronalfrut. {t.derechos.replace('© 2026 Alimentos Pronalfrut. ', '')}
    </p>
  </div>
</footer>






