---
// Tu lógica de props actual
const { title = "Alimentos Pronalfrut", subtitle = "30 años de experiencia..." } = Astro.props;
---

<!-- 1. Sección como contenedor relativo que cubre toda la altura -->
<section class="relative w-full h-[600px] flex items-center justify-center overflow-hidden">
  
  
  <img 
    src="/images/mora.webp" 
    alt="Pulpa de mora Pronalfrut" 
    class="absolute inset-0 w-full h-full object-cover"
  />

  <!-- Capa oscura para asegurar legibilidad -->
  <div class="absolute inset-0 bg-black/50"></div>

  <!-- Contenido centrado -->
  <div class="relative z-10 text-center text-white px-6">
    <h1 class="text-4xl md:text-6xl font-bold mb-6">{title}</h1>
    <p class="text-xl md:text-2xl mb-10 opacity-90">{subtitle}</p>
    
    
<!-- Cambiamos mt-16 por mt-16 md:mt-32 -->
<div class="flex flex-col sm:flex-row items-center justify-center gap-6 mt-16 md:mt-32">
  
  <a href="#productos" class="bg-green-600 hover:bg-green-700 text-white px-8 py-3 rounded-lg font-bold shadow-lg">
    Ver Productos
  </a>

  <a href="#contacto" class="bg-white/20 hover:bg-white/30 text-white px-8 py-3 rounded-lg font-bold backdrop-blur-sm shadow-lg">
    Contáctanos
  </a>
  
</div>

  </div>
</section>













