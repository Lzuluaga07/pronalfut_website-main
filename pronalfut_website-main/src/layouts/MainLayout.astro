---
const { title = "Alimentos Pronalfrut" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    
    <!-- Cambio: Inyección global de Tailwind -->
    <style is:global>
        @tailwind base;
        @tailwind components;
        @tailwind utilities;
    </style>
</head>
<body>
    <slot />

    <!-- Botón Flotante de WhatsApp - Logo Oficial -->
    <a 
      href="https://wa.me/573005519049?text=Hola%20Alimentos%20Pronalfrut" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-[#25D366] rounded-full flex items-center justify-center shadow-lg hover:scale-110 transition-transform duration-300"
      aria-label="Contactar por WhatsApp"
    >
      <img src="https://cdn-icons-png.flaticon.com/512/2111/2111728.png" alt="WhatsApp" class="w-8 h-8 object-contain" />
    </a>
</body>
</html>
















