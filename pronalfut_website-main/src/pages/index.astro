---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import VideoHero from '../components/VideoHero.astro';
import Nosotros from '../components/Nosotros.astro';
import Productos from '../components/Productos.astro';
import TextBlock from '../components/TextBlock.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---


<MainLayout title="Alimentos Pronalfrut - Inicio">
   <Navbar /> <main>
        <Hero />
    </div class="mt-12">
        <VideoHero />
        <Nosotros />
        <Productos />
        
        <!-- Modificamos el título a formato oración según pidió Natalie -->
        <TextBlock 
            title="Nuestro compromiso con la calidad" 
            paragraph="En Alimentos Pronalfrut nos dedicamos a procesar y comercializar pulpa de fruta natural de alta calidad. En Alimentos Pronalfrut, transformamos la riqueza del campo en soluciones saludables."
        />
        
        <!-- Insertamos la sección de clientes aquí antes de contacto -->
        <TestimonialCarousel />
        
        <Contacto />
    </main>
    <Footer />
</MainLayout>


